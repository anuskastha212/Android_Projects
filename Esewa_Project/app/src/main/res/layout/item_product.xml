<?xml version="1.0" encoding="UTF-8" ?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="150dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_product"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:scaleType="centerInside"
            android:padding="16dp"
            android:background="#F5F5F5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/products"/>

        <TextView
            android:id="@+id/title_product"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/product_name"
            android:textSize="14sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toBottomOf="@+id/img_product"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/brand_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/title_product"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/currency_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rs"
            android:textSize="11sp"
            android:textColor="#28A745"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/brand_product"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/price_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_8200"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#28A745"
            android:layout_marginStart="4dp"
            app:layout_constraintBaseline_toBaselineOf="@id/currency_product"
            app:layout_constraintStart_toEndOf="@id/currency_product" />

        <ImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/heart"
            android:background="@android:color/transparent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/price_product"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/layoutAdd"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_add"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/add"
                android:contentDescription="@string/add_sign"
                app:tint="@android:color/white"/>

        </FrameLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/addSub"
            android:layout_width="45dp"
            android:layout_height="150dp"
            android:visibility="gone"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@color/green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/minusButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/minus"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/productQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/addButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/add"
                    android:tint="@android:color/white"/>

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>